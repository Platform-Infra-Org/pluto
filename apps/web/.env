# Dev-only public SPA config for the local integration stack (VITE_* are baked
# into the browser bundle and are non-secret by design). Real deploys inject
# their own. Consumed by `pnpm --dir apps/web dev`.
VITE_OIDC_ISSUER_URL=http://localhost:8080/realms/platform
VITE_OIDC_CLIENT_ID_SPA=platform-ui
VITE_API_BASE_URL=http://localhost:8000/api
