{
  "realm": "platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "clients": [
    {
      "clientId": "platform-ui",
      "name": "Platform SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "platform-ui-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "platform-ui",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "platform-bff",
      "name": "Platform BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "bff-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "platform-ui-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "platform-ui",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "groups": [
    { "name": "platform-admins" },
    { "name": "platform-auditors" },
    { "name": "owners-payments" },
    { "name": "service-owner" }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@platform.dev",
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "groups": ["/platform-admins"]
    },
    {
      "username": "requester",
      "enabled": true,
      "emailVerified": true,
      "email": "requester@platform.dev",
      "firstName": "Rey",
      "lastName": "Requester",
      "credentials": [
        { "type": "password", "value": "requester", "temporary": false }
      ],
      "groups": ["/owners-payments"]
    },
    {
      "username": "auditor",
      "enabled": true,
      "emailVerified": true,
      "email": "auditor@platform.dev",
      "firstName": "Aud",
      "lastName": "Itor",
      "credentials": [
        { "type": "password", "value": "auditor", "temporary": false }
      ],
      "groups": ["/platform-auditors"]
    }
  ]
}
