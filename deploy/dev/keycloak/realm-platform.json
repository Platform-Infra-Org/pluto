{
  "realm": "platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 1800,
  "clients": [
    {
      "clientId": "platform-ui",
      "name": "Platform SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "platform-ui-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "platform-ui",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "platform-bff",
      "name": "Platform BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "bff-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "platform-ui-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "platform-ui",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "backstage",
      "name": "Backstage",
      "enabled": true,
      "publicClient": false,
      "secret": "backstage-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:7007/api/auth/oidc/handler/frame",
        "http://localhost:3000/api/auth/oidc/handler/frame"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:7007"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "backstage-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "backstage",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.storage.UserStorageProvider": [
      {
        "name": "ldap",
        "providerId": "ldap",
        "config": {
          "enabled": [
            "true"
          ],
          "priority": [
            "0"
          ],
          "editMode": [
            "READ_ONLY"
          ],
          "syncRegistrations": [
            "false"
          ],
          "vendor": [
            "other"
          ],
          "usernameLDAPAttribute": [
            "uid"
          ],
          "rdnLDAPAttribute": [
            "uid"
          ],
          "uuidLDAPAttribute": [
            "entryUUID"
          ],
          "userObjectClasses": [
            "inetOrgPerson"
          ],
          "connectionUrl": [
            "ldap://openldap:389"
          ],
          "usersDn": [
            "ou=people,dc=platform,dc=local"
          ],
          "bindDn": [
            "cn=admin,dc=platform,dc=local"
          ],
          "bindCredential": [
            "admin"
          ],
          "searchScope": [
            "1"
          ],
          "importEnabled": [
            "true"
          ],
          "trustEmail": [
            "true"
          ]
        },
        "subComponents": {
          "org.keycloak.storage.ldap.mappers.LDAPStorageMapper": [
            {
              "name": "group-ldap-mapper",
              "providerId": "group-ldap-mapper",
              "config": {
                "mode": [
                  "READ_ONLY"
                ],
                "membership.attribute.type": [
                  "DN"
                ],
                "user.roles.retrieve.strategy": [
                  "LOAD_GROUPS_BY_MEMBER_ATTRIBUTE"
                ],
                "group.name.ldap.attribute": [
                  "cn"
                ],
                "membership.ldap.attribute": [
                  "member"
                ],
                "membership.user.ldap.attribute": [
                  "uid"
                ],
                "group.object.classes": [
                  "groupOfNames"
                ],
                "groups.dn": [
                  "ou=groups,dc=platform,dc=local"
                ],
                "preserve.group.inheritance": [
                  "false"
                ],
                "drop.non.existing.groups.during.sync": [
                  "false"
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
