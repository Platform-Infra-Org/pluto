# Directory seed for the platform: people + groups, mirroring the former
# Keycloak/Gitea users. Base dc=platform,dc=local (created by the server from
# LDAP_DOMAIN); cn=admin is the directory admin. Applied via osixia's custom
# bootstrap (--copy-service). Passwords are dev-only (username == password).

dn: ou=people,dc=platform,dc=local
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=platform,dc=local
objectClass: organizationalUnit
ou: groups

# ---- people (uid == the email local part, so the OIDC resolver matches) ----
dn: uid=admin,ou=people,dc=platform,dc=local
objectClass: inetOrgPerson
uid: admin
cn: Platform Admin
sn: Admin
mail: admin@platform.dev
userPassword: admin

dn: uid=requester,ou=people,dc=platform,dc=local
objectClass: inetOrgPerson
uid: requester
cn: Rey Requester
sn: Requester
mail: requester@platform.dev
userPassword: requester

dn: uid=auditor,ou=people,dc=platform,dc=local
objectClass: inetOrgPerson
uid: auditor
cn: Aud Itor
sn: Itor
mail: auditor@platform.dev
userPassword: auditor

dn: uid=sam,ou=people,dc=platform,dc=local
objectClass: inetOrgPerson
uid: sam
cn: Sam Checkout
sn: Checkout
mail: sam@platform.dev
userPassword: sam

# pat and quinn answer the team-gates workflow's two gates (payments' cost,
# search's schema) without owning the request — the shape that went untested
# while neither gate team had a person in it.
dn: uid=pat,ou=people,dc=platform,dc=local
objectClass: inetOrgPerson
uid: pat
cn: Pat Payments
sn: Payments
mail: pat@platform.dev
userPassword: pat

dn: uid=quinn,ou=people,dc=platform,dc=local
objectClass: inetOrgPerson
uid: quinn
cn: Quinn Search
sn: Search
mail: quinn@platform.dev
userPassword: quinn

# ---- groups (groupOfNames; member = full user DN) ----
dn: cn=platform-admins,ou=groups,dc=platform,dc=local
objectClass: groupOfNames
cn: platform-admins
member: uid=admin,ou=people,dc=platform,dc=local

dn: cn=platform-auditors,ou=groups,dc=platform,dc=local
objectClass: groupOfNames
cn: platform-auditors
member: uid=auditor,ou=people,dc=platform,dc=local

dn: cn=owners-payments,ou=groups,dc=platform,dc=local
objectClass: groupOfNames
cn: owners-payments
member: uid=requester,ou=people,dc=platform,dc=local

dn: cn=checkout,ou=groups,dc=platform,dc=local
objectClass: groupOfNames
cn: checkout
member: uid=sam,ou=people,dc=platform,dc=local

# payments owns the database templates and answers team-gates' cost gate.
dn: cn=payments,ou=groups,dc=platform,dc=local
objectClass: groupOfNames
cn: payments
member: uid=pat,ou=people,dc=platform,dc=local

# search answers team-gates' schema gate and owns nothing.
dn: cn=search,ou=groups,dc=platform,dc=local
objectClass: groupOfNames
cn: search
member: uid=quinn,ou=people,dc=platform,dc=local
